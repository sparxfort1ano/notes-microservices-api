AUTH_PORT=8081

POSTGRES_USER=
POSTGRES_PASSWORD=
# POSTGRES_HOST must be set manually as an environment variable
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_SSL_MODE=disable
POSTGRES_TIMEOUT=5s

PGADMIN_PORT=
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRATION=30m
JWT_REFRESH_TOKEN_EXPIRATION=336h

HTTP_ADDR=:8081
HTTP_SHUTDOWN_TIMEOUT=30s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

## LOGGER_FOLDER must be set manually as an environment variable
LOGGER_LEVEL=DEBUG