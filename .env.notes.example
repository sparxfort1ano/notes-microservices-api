MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_INITDB_DB=
# MONGO_INITDB_HOST must be set manually as an environment variable
MONGO_INITDB_PORT=27017
MONGO_INITDB_SSL_MODE=false
MONGO_INITDB_TIMEOUT=5s
MONGO_INITDB_COLLECTION=notes

HTTP_ADDR=:8082
HTTP_SHUTDOWN_TIMEOUT=30s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# REDIS_HOST must be set manually as an environment variable
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=1h30m
REDIS_TIMEOUT=5s
REDIS_ENABLED=true

JWT_SECRET_KEY=

## LOGGER_FOLDER must be set manually as an environment variable
LOGGER_LEVEL=DEBUG